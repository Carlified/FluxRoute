# 8-input "masked OR" reducer: out = OR_i (en AND d_i)
#
# `en` is read by all 8 AND2T gates directly (no splitter tree --
# that's for your fanout-optimization pass to insert). Clocking is
# also omitted.

.model masked_or8
.inputs en d0 d1 d2 d3 d4 d5 d6 d7
.outputs out

# --- 8x AND2T: t_i = d_i AND en ---
.gate THmitll_AND2T a=d0 b=en q=t0
.gate THmitll_AND2T a=d1 b=en q=t1
.gate THmitll_AND2T a=d2 b=en q=t2
.gate THmitll_AND2T a=d3 b=en q=t3
.gate THmitll_AND2T a=d4 b=en q=t4
.gate THmitll_AND2T a=d5 b=en q=t5
.gate THmitll_AND2T a=d6 b=en q=t6
.gate THmitll_AND2T a=d7 b=en q=t7

# --- OR reduction tree: 8 -> 4 -> 2 -> 1 ---
.gate THmitll_OR2T a=t0 b=t1 q=u0
.gate THmitll_OR2T a=t2 b=t3 q=u1
.gate THmitll_OR2T a=t4 b=t5 q=u2
.gate THmitll_OR2T a=t6 b=t7 q=u3
.gate THmitll_OR2T a=u0 b=u1 q=v0
.gate THmitll_OR2T a=u2 b=u3 q=v1
.gate THmitll_OR2T a=v0 b=v1 q=out

.end
