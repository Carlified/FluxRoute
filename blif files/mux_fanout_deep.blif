# 8-output fanout circuit with deep logic propagation
# Inputs: sel0-sel2 (3-bit select for 8:1 mux), d0-d7 (8 data inputs), enable (gating signal)
# Outputs: out0-out7 (8 processed outputs)
#
# Structure: 
#   Layer 1: 8:1 mux selects one input based on sel0-sel2
#   Layer 2: Enable signal gates the selected data
#   Layer 3: Data is split/duplicated to 8 separate outputs
#   Deep Logic: Each output goes through a 4-stage logic pipeline:
#     - XOR with a copy of itself (always produces 0 initially, setup for later use)
#     - AND with enable signal
#     - OR chain building up
#     - Final NOTT inversion

.model mux_deep_logic
.inputs d0 d1 d2 d3 d4 d5 d6 d7 sel0 sel1 sel2 enable
.outputs out0 out1 out2 out3 out4 out5 out6 out7

# ========== Layer 1: 8:1 Multiplexer Tree ==========

# First level: Four 2:1 muxes
# Mux A: selects between d0 and d1 based on sel0
.gate THmitll_NOTT a=sel0 q=not_sel0_a
.gate THmitll_AND2T a=sel0 b=d1 q=sel0_d1_a
.gate THmitll_AND2T a=not_sel0_a b=d0 q=not_sel0_d0_a
.gate THmitll_OR2T a=sel0_d1_a b=not_sel0_d0_a q=mux_a_raw
.gate THmitll_JTLT a=mux_a_raw q=mux_a

# Mux B: selects between d2 and d3 based on sel0
.gate THmitll_NOTT a=sel0 q=not_sel0_b
.gate THmitll_AND2T a=sel0 b=d3 q=sel0_d3_b
.gate THmitll_AND2T a=not_sel0_b b=d2 q=not_sel0_d2_b
.gate THmitll_OR2T a=sel0_d3_b b=not_sel0_d2_b q=mux_b_raw
.gate THmitll_JTLT a=mux_b_raw q=mux_b

# Mux C: selects between d4 and d5 based on sel0
.gate THmitll_NOTT a=sel0 q=not_sel0_c
.gate THmitll_AND2T a=sel0 b=d5 q=sel0_d5_c
.gate THmitll_AND2T a=not_sel0_c b=d4 q=not_sel0_d4_c
.gate THmitll_OR2T a=sel0_d5_c b=not_sel0_d4_c q=mux_c_raw
.gate THmitll_JTLT a=mux_c_raw q=mux_c

# Mux D: selects between d6 and d7 based on sel0
.gate THmitll_NOTT a=sel0 q=not_sel0_d
.gate THmitll_AND2T a=sel0 b=d7 q=sel0_d7_d
.gate THmitll_AND2T a=not_sel0_d b=d6 q=not_sel0_d6_d
.gate THmitll_OR2T a=sel0_d7_d b=not_sel0_d6_d q=mux_d_raw
.gate THmitll_JTLT a=mux_d_raw q=mux_d

# Second level: Two 2:1 muxes combining the results
# Mux AB: selects between mux_a and mux_b based on sel1
.gate THmitll_NOTT a=sel1 q=not_sel1_ab
.gate THmitll_AND2T a=sel1 b=mux_b q=sel1_mux_b_ab
.gate THmitll_AND2T a=not_sel1_ab b=mux_a q=not_sel1_mux_a_ab
.gate THmitll_OR2T a=sel1_mux_b_ab b=not_sel1_mux_a_ab q=mux_ab_raw
.gate THmitll_JTLT a=mux_ab_raw q=mux_ab

# Mux CD: selects between mux_c and mux_d based on sel1
.gate THmitll_NOTT a=sel1 q=not_sel1_cd
.gate THmitll_AND2T a=sel1 b=mux_d q=sel1_mux_d_cd
.gate THmitll_AND2T a=not_sel1_cd b=mux_c q=not_sel1_mux_c_cd
.gate THmitll_OR2T a=sel1_mux_d_cd b=not_sel1_mux_c_cd q=mux_cd_raw
.gate THmitll_JTLT a=mux_cd_raw q=mux_cd

# Third level: Final 2:1 mux combining AB and CD
# Mux final: selects between mux_ab and mux_cd based on sel2
.gate THmitll_NOTT a=sel2 q=not_sel2_final
.gate THmitll_AND2T a=sel2 b=mux_cd q=sel2_mux_cd_final
.gate THmitll_AND2T a=not_sel2_final b=mux_ab q=not_sel2_mux_ab_final
.gate THmitll_OR2T a=sel2_mux_cd_final b=not_sel2_mux_ab_final q=mux_final_raw
.gate THmitll_JTLT a=mux_final_raw q=mux_final

# ========== Layer 2: Enable gating ==========
.gate THmitll_AND2T a=mux_final b=enable q=gated_signal_raw
.gate THmitll_JTLT a=gated_signal_raw q=gated_signal

# ========== Layer 3: Fanout to 8 outputs (via splitters) ==========
# Since we don't have 8-way splitters, we use repeated JTLT buffers for fanout
.gate THmitll_JTLT a=gated_signal q=fanout_0
.gate THmitll_JTLT a=gated_signal q=fanout_1
.gate THmitll_JTLT a=gated_signal q=fanout_2
.gate THmitll_JTLT a=gated_signal q=fanout_3
.gate THmitll_JTLT a=gated_signal q=fanout_4
.gate THmitll_JTLT a=gated_signal q=fanout_5
.gate THmitll_JTLT a=gated_signal q=fanout_6
.gate THmitll_JTLT a=gated_signal q=fanout_7

# ========== Deep Logic Pipeline Stage 1: XOR with itself ==========
# This always produces 0, but demonstrates pipeline depth
.gate THmitll_XORT a=fanout_0 b=fanout_0 q=stage1_0
.gate THmitll_XORT a=fanout_1 b=fanout_1 q=stage1_1
.gate THmitll_XORT a=fanout_2 b=fanout_2 q=stage1_2
.gate THmitll_XORT a=fanout_3 b=fanout_3 q=stage1_3
.gate THmitll_XORT a=fanout_4 b=fanout_4 q=stage1_4
.gate THmitll_XORT a=fanout_5 b=fanout_5 q=stage1_5
.gate THmitll_XORT a=fanout_6 b=fanout_6 q=stage1_6
.gate THmitll_XORT a=fanout_7 b=fanout_7 q=stage1_7

# ========== Deep Logic Pipeline Stage 2: OR with original signal ==========
# OR stage1 with fanout to get back the signal
.gate THmitll_OR2T a=stage1_0 b=fanout_0 q=stage2_0
.gate THmitll_OR2T a=stage1_1 b=fanout_1 q=stage2_1
.gate THmitll_OR2T a=stage1_2 b=fanout_2 q=stage2_2
.gate THmitll_OR2T a=stage1_3 b=fanout_3 q=stage2_3
.gate THmitll_OR2T a=stage1_4 b=fanout_4 q=stage2_4
.gate THmitll_OR2T a=stage1_5 b=fanout_5 q=stage2_5
.gate THmitll_OR2T a=stage1_6 b=fanout_6 q=stage2_6
.gate THmitll_OR2T a=stage1_7 b=fanout_7 q=stage2_7

# ========== Deep Logic Pipeline Stage 3: AND with enable for gating ==========
.gate THmitll_AND2T a=stage2_0 b=enable q=stage3_0
.gate THmitll_AND2T a=stage2_1 b=enable q=stage3_1
.gate THmitll_AND2T a=stage2_2 b=enable q=stage3_2
.gate THmitll_AND2T a=stage2_3 b=enable q=stage3_3
.gate THmitll_AND2T a=stage2_4 b=enable q=stage3_4
.gate THmitll_AND2T a=stage2_5 b=enable q=stage3_5
.gate THmitll_AND2T a=stage2_6 b=enable q=stage3_6
.gate THmitll_AND2T a=stage2_7 b=enable q=stage3_7

# ========== Deep Logic Pipeline Stage 4: OR reduction chain ==========
# Build up OR chain: pair adjacent outputs
.gate THmitll_OR2T a=stage3_0 b=stage3_1 q=or_chain_0_1
.gate THmitll_OR2T a=stage3_2 b=stage3_3 q=or_chain_2_3
.gate THmitll_OR2T a=stage3_4 b=stage3_5 q=or_chain_4_5
.gate THmitll_OR2T a=stage3_6 b=stage3_7 q=or_chain_6_7

# ========== Deep Logic Pipeline Stage 5: OR reduction continues ==========
.gate THmitll_OR2T a=or_chain_0_1 b=or_chain_2_3 q=or_chain_01_23
.gate THmitll_OR2T a=or_chain_4_5 b=or_chain_6_7 q=or_chain_45_67

# ========== Deep Logic Pipeline Stage 6: Final OR reduction ==========
.gate THmitll_OR2T a=or_chain_01_23 b=or_chain_45_67 q=final_or_result

# ========== Deep Logic Pipeline Stage 7: Final NOTT to create output selection ==========
# Invert the reduction result
.gate THmitll_NOTT a=final_or_result q=final_not_result

# ========== Deep Logic Pipeline Stage 8: Broadcast final result back to outputs ==========
# Use final_not_result as a mask/selector for all outputs
.gate THmitll_AND2T a=stage3_0 b=final_not_result q=out0_raw
.gate THmitll_AND2T a=stage3_1 b=final_not_result q=out1_raw
.gate THmitll_AND2T a=stage3_2 b=final_not_result q=out2_raw
.gate THmitll_AND2T a=stage3_3 b=final_not_result q=out3_raw
.gate THmitll_AND2T a=stage3_4 b=final_not_result q=out4_raw
.gate THmitll_AND2T a=stage3_5 b=final_not_result q=out5_raw
.gate THmitll_AND2T a=stage3_6 b=final_not_result q=out6_raw
.gate THmitll_AND2T a=stage3_7 b=final_not_result q=out7_raw

# ========== Final output buffers ==========
.gate THmitll_JTLT a=out0_raw q=out0
.gate THmitll_JTLT a=out1_raw q=out1
.gate THmitll_JTLT a=out2_raw q=out2
.gate THmitll_JTLT a=out3_raw q=out3
.gate THmitll_JTLT a=out4_raw q=out4
.gate THmitll_JTLT a=out5_raw q=out5
.gate THmitll_JTLT a=out6_raw q=out6
.gate THmitll_JTLT a=out7_raw q=out7

.end
