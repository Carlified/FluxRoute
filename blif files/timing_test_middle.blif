# Timing test middle
# Inputs: in, bypass
# Outputs: out, bypass_out
#
# Part 1: DFF -> DFF -> fanout/fanin tree
#   in -> DFFT -> DFFT (drv) -> split to 16 branches feeding 8 AND2T gates
#      (both AND inputs come from drv) -> OR reduction 8 -> 4 -> 2 -> 1 -> out
#
# Part 2: independent timing path
#   bypass -> DFFT -> bypass_out
#
# Clock pins are omitted here and added in postprocessing.
# Fanout of drv (16 branches) is left for splitter insertion in postprocessing.

.model timing_test_middle
.inputs in bypass
.outputs out bypass_out

# ========== Part 1: DFF -> DFF -> fanout/fanin tree ==========

# Two register stages before the fanout
.gate THmitll_DFFT a=in q=stage1
.gate THmitll_DFFT a=stage1 q=drv

# AND step: 8 cells, each powered by drv on both inputs (16 branches)
.gate THmitll_AND2T a=drv b=drv q=g0
.gate THmitll_AND2T a=drv b=drv q=g1
.gate THmitll_AND2T a=drv b=drv q=g2
.gate THmitll_AND2T a=drv b=drv q=g3
.gate THmitll_AND2T a=drv b=drv q=g4
.gate THmitll_AND2T a=drv b=drv q=g5
.gate THmitll_AND2T a=drv b=drv q=g6
.gate THmitll_AND2T a=drv b=drv q=g7

# Fan-in: 8 -> 4
.gate THmitll_OR2T a=g0 b=g1 q=r4_0
.gate THmitll_OR2T a=g2 b=g3 q=r4_1
.gate THmitll_OR2T a=g4 b=g5 q=r4_2
.gate THmitll_OR2T a=g6 b=g7 q=r4_3

# Fan-in: 4 -> 2
.gate THmitll_OR2T a=r4_0 b=r4_1 q=r2_0
.gate THmitll_OR2T a=r4_2 b=r4_3 q=r2_1

# Fan-in: 2 -> 1
.gate THmitll_OR2T a=r2_0 b=r2_1 q=out

# ========== Part 2: single DFFT from bypass to bypass_out ==========
.gate THmitll_DFFT a=bypass q=bypass_out

.end
