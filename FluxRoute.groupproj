<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{98C11570-EF1E-439B-AB44-92657F0B5738}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="FluxRoute.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="BlifParser.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="LefParser.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="FluxRoute">
        <MSBuild Projects="FluxRoute.dproj"/>
    </Target>
    <Target Name="FluxRoute:Clean">
        <MSBuild Projects="FluxRoute.dproj" Targets="Clean"/>
    </Target>
    <Target Name="FluxRoute:Make">
        <MSBuild Projects="FluxRoute.dproj" Targets="Make"/>
    </Target>
    <Target Name="BlifParser">
        <MSBuild Projects="BlifParser.dproj"/>
    </Target>
    <Target Name="BlifParser:Clean">
        <MSBuild Projects="BlifParser.dproj" Targets="Clean"/>
    </Target>
    <Target Name="BlifParser:Make">
        <MSBuild Projects="BlifParser.dproj" Targets="Make"/>
    </Target>
    <Target Name="LefParser">
        <MSBuild Projects="LefParser.dproj"/>
    </Target>
    <Target Name="LefParser:Clean">
        <MSBuild Projects="LefParser.dproj" Targets="Clean"/>
    </Target>
    <Target Name="LefParser:Make">
        <MSBuild Projects="LefParser.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="FluxRoute;BlifParser;LefParser"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="FluxRoute:Clean;BlifParser:Clean;LefParser:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="FluxRoute:Make;BlifParser:Make;LefParser:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
