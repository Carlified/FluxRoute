MACRO THmitll_AND2T
	CLASS CORE ;
	ORIGIN 0.0 0.0 ;
	SIZE 50.0 BY 70.0 ;
	SYMMETRY X Y ;
	SITE CoreSite ;
	PIN a
	DIRECTION INPUT ;
	USE SIGNAL ;
		PORT
			LAYER M3 ;
				RECT 12.8 62.8 17.2 67.2 ;
			LAYER M1 ;
				RECT 12.8 62.8 17.2 67.2 ;
		END
	END a
	PIN clk
	DIRECTION INPUT ;
	USE CLOCK ;
		PORT
			LAYER M3 ;
				RECT 2.8 2.8 7.2 7.2 ;
			LAYER M1 ;
				RECT 2.8 2.8 7.2 7.2 ;
		END
	END clk
	PIN q
	DIRECTION OUTPUT ;
	USE SIGNAL ;
		PORT
			LAYER M3 ;
				RECT 42.8 22.8 47.2 27.2 ;
			LAYER M1 ;
				RECT 42.8 22.8 47.2 27.2 ;
		END
	END q
	PIN b
	DIRECTION INPUT ;
	USE SIGNAL ;
		PORT
			LAYER M3 ;
				RECT 42.8 12.8 47.2 17.2 ;
			LAYER M1 ;
				RECT 42.8 12.8 47.2 17.2 ;
		END
	END b
	PIN VDD
	DIRECTION INOUT ;
	USE POWER ;
		# bottom edge, 50uA
		PORT
			LAYER M5 ;
				RECT 14 0 16 3 ;
		END
		# top edge, 50uA
		PORT
			LAYER M5 ;
				RECT 4 67 6 70 ;
		END
		# top edge, 50uA
		PORT
			LAYER M5 ;
				RECT 44 64 46 70 ;
		END
	END VDD
END THmitll_AND2T

