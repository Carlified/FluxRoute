# Combinational test: 2x2 unsigned multiplier (9 gates)
# Inputs: a0 a1 (a = a1a0), b0 b1 (b = b1b0)
# Outputs: p0-p3 (p = a*b)
# Partial products pp_ij = a_i AND b_j; bit 1 and 2 summed with a half adder chain

.model comb_mult2x2
.inputs a0 a1 b0 b1
.outputs p0 p1 p2 p3

# Partial products
.gate THmitll_AND2T a=a0 b=b0 q=pp00
.gate THmitll_AND2T a=a1 b=b0 q=pp10
.gate THmitll_AND2T a=a0 b=b1 q=pp01
.gate THmitll_AND2T a=a1 b=b1 q=pp11

# Bit 0
.gate THmitll_JTLT a=pp00 q=p0

# Bit 1: half adder of pp10 and pp01
.gate THmitll_XORT a=pp10 b=pp01 q=p1
.gate THmitll_AND2T a=pp10 b=pp01 q=c1

# Bit 2: half adder of pp11 and c1
.gate THmitll_XORT a=pp11 b=c1 q=p2
.gate THmitll_AND2T a=pp11 b=c1 q=p3

.end
