<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <Import Condition="Exists('$(BDS)\bin\CodeGear.Deployment.targets')" Project="$(BDS)\bin\CodeGear.Deployment.targets"/>
    <ProjectExtensions>
        <ProjectFileVersion>12</ProjectFileVersion>
    </ProjectExtensions>
    <PropertyGroup/>
    <ItemGroup Condition="'$(Platform)'=='OSX64'"/>
    <ItemGroup Condition="'$(Platform)'=='Win32'">
        <DeployFile Include="Win32\Debug\PnRGUI.exe" Condition="'$(Config)'=='Debug'">
            <RemoteDir>PnRGUI\</RemoteDir>
            <RemoteName>PnRGUI.exe</RemoteName>
            <DeployClass>ProjectOutput</DeployClass>
            <Operation>0</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
            <Required>True</Required>
        </DeployFile>
    </ItemGroup>
    <ItemGroup Condition="'$(Platform)'=='OSXARM64'">
        <DeployFile Include="OSXARM64\Debug\PnRGUI" Condition="'$(Config)'=='Debug'">
            <RemoteDir>PnRGUI.app\Contents\MacOS\</RemoteDir>
            <RemoteName>PnRGUI</RemoteName>
            <DeployClass>ProjectOutput</DeployClass>
            <Operation>1</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
            <Required>True</Required>
        </DeployFile>
        <DeployFile Include="Pipeline.inc" Condition="'$(Config)'=='Debug'">
            <RemoteDir>PnRGUI.app\Contents\Resources\StartUp\</RemoteDir>
            <RemoteName>Pipeline.inc</RemoteName>
            <DeployClass>ProjectFile</DeployClass>
            <Operation>0</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
        <DeployFile Include="FloorPlan.inc" Condition="'$(Config)'=='Debug'">
            <RemoteDir>PnRGUI.app\Contents\Resources\StartUp\</RemoteDir>
            <RemoteName>FloorPlan.inc</RemoteName>
            <DeployClass>ProjectFile</DeployClass>
            <Operation>0</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
        <DeployFile Include="OSXARM64\Debug\PnRGUI.entitlements" Condition="'$(Config)'=='Debug'">
            <RemoteDir>PnRGUI.app\..\</RemoteDir>
            <RemoteName>PnRGUI.entitlements</RemoteName>
            <DeployClass>ProjectOSXEntitlements</DeployClass>
            <Operation>1</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
        <DeployFile Include="OSXARM64\Debug\PnRGUI.dSYM" Condition="'$(Config)'=='Debug'">
            <RemoteDir>PnRGUI.app\..\$(PROJECTNAME).app.dSYM\Contents\Resources\DWARF\</RemoteDir>
            <RemoteName>PnRGUI</RemoteName>
            <DeployClass>ProjectOSXDebug</DeployClass>
            <Operation>1</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
        <DeployFile Include="OSXARM64\Debug\PnRGUI.info.plist" Condition="'$(Config)'=='Debug'">
            <RemoteDir>PnRGUI.app\Contents\</RemoteDir>
            <RemoteName>Info.plist</RemoteName>
            <DeployClass>ProjectOSXInfoPList</DeployClass>
            <Operation>1</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
        <DeployFile Include="Placement.inc" Condition="'$(Config)'=='Debug'">
            <RemoteDir>PnRGUI.app\Contents\Resources\StartUp\</RemoteDir>
            <RemoteName>Placement.inc</RemoteName>
            <DeployClass>ProjectFile</DeployClass>
            <Operation>0</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
        <DeployFile Include="$(BDS)\bin\delphi_PROJECTICNS.icns" Condition="'$(Config)'=='Debug'">
            <RemoteDir>PnRGUI.app\Contents\Resources\</RemoteDir>
            <RemoteName>PnRGUI.icns</RemoteName>
            <DeployClass>ProjectOSXResource</DeployClass>
            <Operation>1</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
        <DeployFile Include="ConfigIO.inc" Condition="'$(Config)'=='Debug'">
            <RemoteDir>PnRGUI.app\Contents\Resources\StartUp\</RemoteDir>
            <RemoteName>ConfigIO.inc</RemoteName>
            <DeployClass>ProjectFile</DeployClass>
            <Operation>0</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
        <DeployFile Include="Routing.inc" Condition="'$(Config)'=='Debug'">
            <RemoteDir>PnRGUI.app\Contents\Resources\StartUp\</RemoteDir>
            <RemoteName>Routing.inc</RemoteName>
            <DeployClass>ProjectFile</DeployClass>
            <Operation>0</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
        <DeployFile Include="ClockPage.inc" Condition="'$(Config)'=='Debug'">
            <RemoteDir>PnRGUI.app\Contents\Resources\StartUp\</RemoteDir>
            <RemoteName>ClockPage.inc</RemoteName>
            <DeployClass>ProjectFile</DeployClass>
            <Operation>0</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
    </ItemGroup>
    <ItemGroup Condition="'$(Platform)'=='Win64'">
        <DeployFile Include="ClockPage.inc" Condition="'$(Config)'=='Debug'">
            <RemoteDir>PnRGUI\</RemoteDir>
            <RemoteName>ClockPage.inc</RemoteName>
            <DeployClass>ProjectFile</DeployClass>
            <Operation>0</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
        <DeployFile Include="Win64\Debug\PnRGUI.exe" Condition="'$(Config)'=='Debug'">
            <RemoteDir>PnRGUI\</RemoteDir>
            <RemoteName>PnRGUI.exe</RemoteName>
            <DeployClass>ProjectOutput</DeployClass>
            <Operation>0</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
            <Required>True</Required>
        </DeployFile>
        <DeployFile Include="Routing.inc" Condition="'$(Config)'=='Debug'">
            <RemoteDir>PnRGUI\</RemoteDir>
            <RemoteName>Routing.inc</RemoteName>
            <DeployClass>ProjectFile</DeployClass>
            <Operation>0</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
        <DeployFile Include="ConfigIO.inc" Condition="'$(Config)'=='Debug'">
            <RemoteDir>PnRGUI\</RemoteDir>
            <RemoteName>ConfigIO.inc</RemoteName>
            <DeployClass>ProjectFile</DeployClass>
            <Operation>0</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
        <DeployFile Include="Pipeline.inc" Condition="'$(Config)'=='Debug'">
            <RemoteDir>PnRGUI\</RemoteDir>
            <RemoteName>Pipeline.inc</RemoteName>
            <DeployClass>ProjectFile</DeployClass>
            <Operation>0</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
        <DeployFile Include="FloorPlan.inc" Condition="'$(Config)'=='Debug'">
            <RemoteDir>PnRGUI\</RemoteDir>
            <RemoteName>FloorPlan.inc</RemoteName>
            <DeployClass>ProjectFile</DeployClass>
            <Operation>0</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
        <DeployFile Include="Placement.inc" Condition="'$(Config)'=='Debug'">
            <RemoteDir>PnRGUI\</RemoteDir>
            <RemoteName>Placement.inc</RemoteName>
            <DeployClass>ProjectFile</DeployClass>
            <Operation>0</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
    </ItemGroup>
    <ItemGroup Condition="'$(Platform)'=='Win64x'"/>
</Project>
