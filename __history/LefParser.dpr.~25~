program LefParser;

{$APPTYPE CONSOLE}
{$R *.res}

uses
  System.SysUtils,
  System.Classes,
  System.Generics.Collections,
  System.StrUtils;
// use comma to seperate

type
  TPort = class
  public
    Name: string;

    Layer: string;

    x1, x2, y1, y2: Double;
  end;

  TCell = class
  public
    Name: string;

    Width: Double;
    Height: Double;

    Ports: TObjectList<TPort>;

    constructor Create;
    destructor Destroy; override;
  end;

  TLibrary = class
  public
    Cells: TObjectList<TCell>;

    constructor Create;
    destructor Destroy; override;
  end;

constructor TLibrary.Create;
begin
  Cells := TObjectList<TCell>.Create(True);
end;

destructor TLibrary.Destroy;
begin
  Cells.Free;
  inherited;
end;

constructor TCell.Create;
begin
  Ports := TObjectList<TPort>.Create(True);
end;

destructor TCell.Destroy;
begin
  Ports.Free;
  inherited;
end;

var

  i: integer;

  Lines: TStringList;
  Line: string;
  Parts: TArray<string>;

  Lib: TLibrary;

  CurrentCell: TCell;
  Cell: TCell;

  Port: TPort;
  CurrentPort: TPort;
  x1, x2, y1, y2: Double;

begin
  Lib := TLibrary.Create;
  Lines := TStringList.Create; // constructor
  try // prevent memory leaks on Lib and Lines - close after finishing
    Lines.LoadFromFile('lef_7_metals.lef'); // change location to test
    CurrentCell := nil;
    CurrentPort := nil;
    for i := 0 to Lines.Count - 1 do
    begin

      Line := Trim(Lines[i]);
      if StartsText('MACRO', Line) then
      begin
        Parts := Line.Split([' '], TStringSplitOptions.ExcludeEmpty);
        CurrentCell := TCell.Create;
        CurrentCell.Name := Parts[1];
        Lib.Cells.Add(CurrentCell);

      end

      else if (CurrentCell <> nil) and StartsText('SIZE', Line) then
      begin
        Parts := Line.Split([' '], TStringSplitOptions.ExcludeEmpty);
        CurrentCell.Width := StrToFloat(Parts[1]);
        CurrentCell.Height := StrToFloat(Parts[3]);

      end

      else if (CurrentCell <> nil) and StartsText('PIN', Line) then
      begin
        Parts := Line.Split([' '], TStringSplitOptions.ExcludeEmpty);
        CurrentPort := TPort.Create;
        CurrentPort.Name := Parts[1];
        CurrentCell.Ports.Add(CurrentPort);
      end

      else if (CurrentCell <> nil) and (CurrentPort <> nil) and
        StartsText('LAYER', Line) then
      begin
        Parts := Line.Split([' '], TStringSplitOptions.ExcludeEmpty);
        CurrentPort.Layer := Parts[1];
      end

      else if (CurrentCell <> nil) and (CurrentPort <> nil) and
        StartsText('RECT', Line) then
      begin
        Parts := Line.Split([' '], TStringSplitOptions.ExcludeEmpty);

        CurrentPort.x1 := StrToFloat(Parts[1]);
        CurrentPort.y1 := StrToFloat(Parts[2]);
        CurrentPort.x2 := StrToFloat(Parts[3]);
        CurrentPort.y2 := StrToFloat(Parts[4]);

      end

      else if StartsText('END', Line) then
      begin
        if Assigned(CurrentCell) then
        begin
          Parts := Line.Split([' '], TStringSplitOptions.ExcludeEmpty);

          if (Length(Parts) > 1) then
          begin

            if SameText(Parts[1], CurrentCell.Name) then
            begin
              CurrentCell := nil;
              CurrentPort := nil;
            end
            else if Assigned(CurrentPort) and
              SameText(Parts[1], CurrentPort.Name) then
            begin
              CurrentPort := nil;
            end;
          end;
        end;
      end;

    end;

    for Cell in Lib.Cells do
    begin

      Writeln(Cell.Name);

      Writeln(Cell.Width:0:1, ', ', Cell.Height:0:1);

      for Port in Cell.Ports do
        Writeln('   ', Port.Name, ': Layer ', Port.Layer, ' ((', Port.x1:0:1, ',',
          Port.y1:0:1, '), (' , Port.x2:0:1 ,', ', Port.y2:0:1,'))');

      Writeln(sLineBreak);
    end;
  finally
    Lines.Free;
    Lib.Free;
  end;

end.
