unit BlifLibrary;

interface

uses
  System.SysUtils,
  System.Classes,
  System.Generics.Collections,
  System.StrUtils,
  LefLibrary;

type
  // One pin=net assignment on a .gate line, resolved against the library.
  TPinConnection = class
  public
    PinName: string;
    NetName: string;
    Port: TPort; // resolved pointer into the LEF library; never nil once built
  end;

  // One .gate instance from the BLIF file.
  TGateInstance = class
  public
    CellName: string;
    Cell: TCell; // resolved pointer into the LEF library; never nil once built
    Connections: TObjectList<TPinConnection>;
    constructor Create;
    destructor Destroy; override;
  end;

  TNetConnection = record // Delphi version of a struct
    Gate: TGateInstance;
    PinName: string;
    IsDriver: Boolean; // True if this connection is the OUTPUT pin driving the net
  end;

  // A named wire and everything attached to it.
  TNet = class
  public
    Name: string;
    Connections: TList<TNetConnection>;
    constructor Create;
    destructor Destroy; override;
  end;

  TBlifModel = class
  public
    Name: string;
    Inputs: TStringList;  // primary inputs of the whole circuit
    Outputs: TStringList; // primary outputs of the whole circuit
    Gates: TObjectList<TGateInstance>;
    Nets: TObjectDictionary<string, TNet>;
    constructor Create;
    destructor Destroy; override;
    function FindOrCreateNet(const NetName: string): TNet;
  end;

// Parses a BLIF file, validating every .gate's cell and pin names against Lib.
// Problems are appended to Errors as human-readable strings; parsing continues
// past an error where it can (e.g. an unknown pin just gets skipped, the rest
// of that gate's valid pins are still built). Caller owns the result and must
// free it; caller should check Errors.Count before trusting the result.
function ParseBlif(const FileName: string; Lib: TLibrary; Errors: TStrings): TBlifModel;

// Walks the already-built net list and reports connectivity problems:
//  - any net with more than one driver (a short, regardless of I/O status)
//  - any internal net (not a primary input/output) with no driver, or no loader
//  - as a bonus: a primary output with no internal driver, or a primary input
//    with no internal loader, since those are dead pins even though they're
//    not what you asked for specifically
// This is a separate pass, not folded into ParseBlif, because it needs the
// complete net list to know a net's final driver/load counts -- unlike cell
// and pin validation, this genuinely can't be checked line-by-line.
procedure CheckNetConnectivity(Model: TBlifModel; Errors: TStrings);

implementation

{ TGateInstance }

constructor TGateInstance.Create;
begin
  Connections := TObjectList<TPinConnection>.Create(True);
end;

destructor TGateInstance.Destroy;
begin
  Connections.Free;
  inherited;
end;

{ TNet }

constructor TNet.Create;
begin
  Connections := TList<TNetConnection>.Create;
end;

destructor TNet.Destroy;
begin
  Connections.Free;
  inherited;
end;

{ TBlifModel }

constructor TBlifModel.Create;
begin
  Inputs := TStringList.Create;
  Inputs.CaseSensitive := False; // keep all name matching case-insensitive
  Outputs := TStringList.Create;
  Outputs.CaseSensitive := False;
  Gates := TObjectList<TGateInstance>.Create(True);
  Nets := TObjectDictionary<string, TNet>.Create([doOwnsValues]);
end;

destructor TBlifModel.Destroy;
begin
  Inputs.Free;
  Outputs.Free;
  Gates.Free;
  Nets.Free;
  inherited;
end;

function TBlifModel.FindOrCreateNet(const NetName: string): TNet;
begin
  if not Nets.TryGetValue(NetName, Result) then
  begin
    Result := TNet.Create;
    Result.Name := NetName;
    Nets.Add(NetName, Result);
  end;
end;

{ Parsing }

function ParseBlif(const FileName: string; Lib: TLibrary; Errors: TStrings): TBlifModel;
var
  i, j: Integer;
  Lines: TStringList;
  Line: string;
  Parts: TArray<string>;
  AssignParts: TArray<string>;
  Cell: TCell;
  Port: TPort;
  Gate: TGateInstance;
  Conn: TPinConnection;
  Net: TNet;
  NC: TNetConnection;
  PinName, NetName: string;
begin
  Result := TBlifModel.Create;
  Lines := TStringList.Create;
  try
    Lines.LoadFromFile(FileName);

    for i := 0 to Lines.Count - 1 do
    begin
      Line := Trim(Lines[i]);

      // skip blank lines and comments
      if (Line = '') or StartsText('#', Line) then
        Continue;

      if StartsText('.model', Line) then
      begin
        Parts := Line.Split([' '], TStringSplitOptions.ExcludeEmpty);
        if Length(Parts) > 1 then // bounds check
          Result.Name := Parts[1];
      end

      else if StartsText('.inputs', Line) then
      begin
        Parts := Line.Split([' '], TStringSplitOptions.ExcludeEmpty);
        for j := 1 to Length(Parts) - 1 do
        begin
          Result.Inputs.Add(Parts[j]);
          Result.FindOrCreateNet(Parts[j]);
        end;
      end

      else if StartsText('.outputs', Line) then
      begin
        Parts := Line.Split([' '], TStringSplitOptions.ExcludeEmpty);
        for j := 1 to Length(Parts) - 1 do
        begin
          Result.Outputs.Add(Parts[j]);
          Result.FindOrCreateNet(Parts[j]);
        end;
      end

      else if StartsText('.gate', Line) then
      begin
        Parts := Line.Split([' '], TStringSplitOptions.ExcludeEmpty);
        if Length(Parts) < 2 then
        begin
          Errors.Add(Format('Line %d: malformed .gate line', [i + 1]));
          Continue;
        end;

        Cell := Lib.FindCell(Parts[1]); // verify cell name against LEF
        if Cell = nil then
        begin
          Errors.Add(Format('Line %d: unknown cell "%s"', [i + 1, Parts[1]]));
          Continue; // can't validate pins against a cell that doesn't exist
        end;

        Gate := TGateInstance.Create;
        Gate.CellName := Parts[1];
        Gate.Cell := Cell;

        for j := 2 to Length(Parts) - 1 do
        begin
          AssignParts := Parts[j].Split(['=']); // get pin name and wire name
          if Length(AssignParts) <> 2 then
          begin
            Errors.Add(Format('Line %d: broken pin assignment "%s"', [i + 1, Parts[j]]));
            Continue;
          end;

          PinName := AssignParts[0];
          NetName := AssignParts[1];

          Port := Cell.FindPort(PinName); // verify port against LEF
          if Port = nil then
          begin
            Errors.Add(Format('Line %d: cell "%s" has no pin "%s"',
              [i + 1, Cell.Name, PinName]));
            Continue; // skip just this connection, keep the rest of the gate
          end;

          Conn := TPinConnection.Create;
          Conn.PinName := PinName;
          Conn.NetName := NetName;
          Conn.Port := Port;
          Gate.Connections.Add(Conn);

          Net := Result.FindOrCreateNet(NetName);
          NC.Gate := Gate;
          NC.PinName := PinName;
          NC.IsDriver := (Port.Direction = pdOutput);
          Net.Connections.Add(NC);
        end;

        Result.Gates.Add(Gate);
      end

      else if StartsText('.end', Line) then
        Break; // single-model files only; stop here
    end;
  finally
    Lines.Free;
  end;
end;

procedure CheckNetConnectivity(Model: TBlifModel; Errors: TStrings);
var
  NetName, Drivers: string;
  Net: TNet;
  NC: TNetConnection;
  DriverCount, LoadCount: Integer;
  IsPrimaryInput, IsPrimaryOutput: Boolean;
begin
  for NetName in Model.Nets.Keys do
  begin
    Net := Model.Nets[NetName];

    DriverCount := 0;
    LoadCount := 0;
    Drivers := '';

    for NC in Net.Connections do
    begin
      if NC.IsDriver then
      begin
        Inc(DriverCount);
        if Drivers <> '' then
          Drivers := Drivers + ', ';
        Drivers := Drivers + NC.Gate.CellName + '.' + NC.PinName;
      end
      else
        Inc(LoadCount);
    end;

    IsPrimaryInput := Model.Inputs.IndexOf(NetName) >= 0;
    IsPrimaryOutput := Model.Outputs.IndexOf(NetName) >= 0;

    // A net can have any number of loads -- splitters get inserted later to
    // fan a single driver out to them -- but two drivers on one net is a
    // short, never valid.
    if DriverCount > 1 then
      Errors.Add(Format('Net "%s" has %d drivers (%s) -- a net may have at most 1 driver',
        [NetName, DriverCount, Drivers]));

    if not IsPrimaryInput and not IsPrimaryOutput then
    begin
      if DriverCount = 0 then
        Errors.Add(Format('Net "%s" has no driver', [NetName]));
      if LoadCount = 0 then
        Errors.Add(Format('Net "%s" has no loader', [NetName]));
    end
    else
    begin
      // Primary I/O nets are allowed to be undriven/unloaded *internally*
      // (an input is driven from outside the circuit; an output is loaded
      // outside it) -- but the other side still ought to exist.
      if IsPrimaryOutput and (DriverCount = 0) then
        Errors.Add(Format('Net "%s" is a primary output but no gate drives it', [NetName]));
      if IsPrimaryInput and (LoadCount = 0) then
        Errors.Add(Format('Net "%s" is a primary input but no gate uses it', [NetName]));
    end;
  end;
end;

end.
