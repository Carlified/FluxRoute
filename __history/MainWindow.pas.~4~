unit MainWindow;

interface

uses
  System.SysUtils, System.Types, System.UITypes, System.Classes, System.Variants,
  FMX.Types, FMX.Controls, FMX.Forms, FMX.Graphics, FMX.Dialogs, FMX.StdCtrls,
  FMX.Controls.Presentation, FMX.ListBox, FMX.Layouts, FMX.TabControl,
  System.IOUtils,
  LefLibrary,
  BlifLibrary;

type
  TForm1 = class(TForm)
    TabControl1: TTabControl;
    TabItem1: TTabItem;
    WelcomeLabel: TLabel;
    Button1: TButton;
    Button2: TButton;
    TabItem2: TTabItem;
    Button3: TButton;
    Button4: TButton;
    ListBox1: TListBox;
    Label1: TLabel;
    TabItem3: TTabItem;
    Button5: TButton;
    Button6: TButton;
    Memo1: TMemo;
    ButtonBack: TButton;
    ButtonNext: TButton;
    OpenDialog1: TOpenDialog;
    procedure FormCreate(Sender: TObject);
    procedure FormDestroy(Sender: TObject);
    procedure Button1Click(Sender: TObject);
    procedure Button2Click(Sender: TObject);
    procedure Button3Click(Sender: TObject);
    procedure Button4Click(Sender: TObject);
    procedure Button5Click(Sender: TObject);
    procedure Button6Click(Sender: TObject);
    procedure ButtonBackClick(Sender: TObject);
    procedure ButtonNextClick(Sender: TObject);
  private
    FLefFile: string;
    FCellFolder: string;
    FBlifFile: string;
    FLib: TLibrary;
    FModel: TBlifModel;
    procedure FreeLib;
    procedure UpdateUI;
    procedure RenderNetlist(Model: TBlifModel; Errors: TStrings);
  public
    { Public declarations }
  end;

var
  Form1: TForm1;

implementation

{$R *.fmx}

procedure TForm1.FreeLib;
begin
  FModel.Free;
  FModel := nil;
  FLib.Free;
  FLib := nil;
end;

procedure TForm1.UpdateUI;
begin
  Button2.Enabled := (FLefFile <> '');
  Button4.Enabled := (FLib <> nil) and (FCellFolder <> '');
  Button6.Enabled := (FLib <> nil) and (FBlifFile <> '');
  ButtonBack.Enabled := (TabControl1.TabIndex > 0);
  ButtonNext.Enabled := (FLib <> nil) and
    (TabControl1.TabIndex < TabControl1.TabCount - 1);
end;

procedure TForm1.FormCreate(Sender: TObject);
begin
  UpdateUI;
end;

procedure TForm1.FormDestroy(Sender: TObject);
begin
  FreeLib;
end;

procedure TForm1.Button1Click(Sender: TObject);
begin
  OpenDialog1.Filter := 'LEF files (*.lef)|*.lef|All files (*.*)|*.*';
  OpenDialog1.FilterIndex := 1;
  if OpenDialog1.Execute then
  begin
    FLefFile := OpenDialog1.FileName;
    FreeLib; // a new LEF file invalidates the previously parsed library
    ListBox1.Clear;
    Memo1.Clear;
    Label1.Text := 'Selected: ' + FLefFile;
    UpdateUI;
  end;
end;

procedure TForm1.Button2Click(Sender: TObject);
var
  Lib: TLibrary;
  i: Integer;
begin
  if FLefFile = '' then
  begin
    ShowMessage('Select a LEF file first.');
    Exit;
  end;

  try
    Lib := LoadLefLibrary(FLefFile);
  except
    on E: Exception do
    begin
      ShowMessage('Failed to parse LEF file:' + sLineBreak + sLineBreak + E.Message);
      Exit;
    end;
  end;

  FreeLib;
  FLib := Lib;

  ListBox1.Clear;
  for i := 0 to FLib.Cells.Count - 1 do
    ListBox1.Items.Add(FLib.Cells[i].Name);
  Label1.Text := Format('Loaded %d cell(s) from %s',
    [FLib.Cells.Count, ExtractFileName(FLefFile)]);
  UpdateUI;
end;

procedure TForm1.Button3Click(Sender: TObject);
var
  Folder: string;
begin
  Folder := '';
  if SelectDirectory('Select folder containing cell source files', '', Folder) then
  begin
    FCellFolder := Folder;
    ListBox1.Clear;
    Label1.Text := 'Cell folder: ' + FCellFolder;
    UpdateUI;
  end;
end;

procedure TForm1.Button4Click(Sender: TObject);
var
  Cell: TCell;
  Path: string;
  CellsWithMatches, TotalFiles: Integer;
begin
  if FLib = nil then
  begin
    ShowMessage('Parse a LEF file first.');
    Exit;
  end;

  if FCellFolder = '' then
  begin
    ShowMessage('Select a cell folder first.');
    Exit;
  end;

  if not TDirectory.Exists(FCellFolder) then
  begin
    ShowMessage('Cell folder no longer exists.');
    Exit;
  end;

  FLib.FindCellSourceFiles(FCellFolder);

  ListBox1.Clear;
  CellsWithMatches := 0;
  TotalFiles := 0;
  for Cell in FLib.Cells do
  begin
    if Cell.SourceFiles.Count > 0 then
    begin
      Inc(CellsWithMatches);
      Inc(TotalFiles, Cell.SourceFiles.Count);
      for Path in Cell.SourceFiles do
        ListBox1.Items.Add(Cell.Name + ' -> ' + Path);
    end
    else
      ListBox1.Items.Add(Cell.Name + ' (no linked file found)');
  end;

  Label1.Text := Format('Found %d linked file(s) for %d of %d cells in %s',
    [TotalFiles, CellsWithMatches, FLib.Cells.Count, FCellFolder]);
end;

procedure TForm1.Button5Click(Sender: TObject);
begin
  OpenDialog1.Filter := 'BLIF files (*.blif)|*.blif|All files (*.*)|*.*';
  OpenDialog1.FilterIndex := 1;
  if OpenDialog1.Execute then
  begin
    FBlifFile := OpenDialog1.FileName;
    FModel.Free; // a new BLIF file invalidates the previously parsed netlist
    FModel := nil;
    Memo1.Clear;
    Label1.Text := 'Selected: ' + FBlifFile;
    UpdateUI;
  end;
end;

procedure TForm1.Button6Click(Sender: TObject);
var
  Errors: TStringList;
  Model: TBlifModel;
begin
  Model := nil;
  if FLib = nil then
  begin
    ShowMessage('Parse a LEF file first.');
    Exit;
  end;

  if FBlifFile = '' then
  begin
    ShowMessage('Select a BLIF file first.');
    Exit;
  end;

  Errors := TStringList.Create;
  try
    try
      Model := ParseBlif(FBlifFile, FLib, Errors);
    except
      on E: Exception do
      begin
        ShowMessage('Failed to parse BLIF file:' + sLineBreak + sLineBreak + E.Message);
        Exit;
      end;
    end;

    CheckNetConnectivity(Model, Errors);

    FModel.Free;
    FModel := Model;

    RenderNetlist(FModel, Errors);
    Label1.Text := Format('Loaded netlist "%s": %d gate(s), %d net(s), %d error(s)',
      [FModel.Name, FModel.Gates.Count, FModel.Nets.Count, Errors.Count]);
  finally
    Errors.Free;
  end;
  UpdateUI;
end;

procedure TForm1.RenderNetlist(Model: TBlifModel; Errors: TStrings);
var
  Dump: TStringList;
  i: Integer;
  Gate: TGateInstance;
  Conn: TPinConnection;
  Net: TNet;
  NC: TNetConnection;
  NetName: string;
  Line: string;
begin
  Dump := TStringList.Create;
  try
    Dump.Add('Model: ' + Model.Name);
    Dump.Add('');
    Dump.Add('Primary inputs: ' + Model.Inputs.CommaText);
    Dump.Add('Primary outputs: ' + Model.Outputs.CommaText);
    Dump.Add('');

    Dump.Add(Format('Gates (%d):', [Model.Gates.Count]));
    for i := 0 to Model.Gates.Count - 1 do
    begin
      Gate := Model.Gates[i];
      Line := Format('  %2d. %s', [i + 1, Gate.CellName]);
      for Conn in Gate.Connections do
        Line := Line + Format('  %s=%s', [Conn.PinName, Conn.NetName]);
      Dump.Add(Line);
    end;
    Dump.Add('');

    Dump.Add(Format('Nets (%d):', [Model.Nets.Count]));
    for NetName in Model.Nets.Keys do
    begin
      Net := Model.Nets[NetName];
      Line := '  ' + NetName + ':';
      for NC in Net.Connections do
      begin
        if NC.IsDriver then
          Line := Line + Format('  drive=%s.%s', [NC.Gate.CellName, NC.PinName])
        else
          Line := Line + Format('  load=%s.%s', [NC.Gate.CellName, NC.PinName]);
      end;
      Dump.Add(Line);
    end;

    Dump.Add('');
    if Errors.Count > 0 then
    begin
      Dump.Add(Format('ERRORS (%d):', [Errors.Count]));
      for i := 0 to Errors.Count - 1 do
        Dump.Add('  ' + Errors[i]);
    end
    else
      Dump.Add('No errors.');

    Memo1.Lines.Assign(Dump);
  finally
    Dump.Free;
  end;
end;

procedure TForm1.ButtonBackClick(Sender: TObject);
begin
  if TabControl1.TabIndex > 0 then
    TabControl1.TabIndex := TabControl1.TabIndex - 1;
  UpdateUI;
end;

procedure TForm1.ButtonNextClick(Sender: TObject);
begin
  if TabControl1.TabIndex < TabControl1.TabCount - 1 then
    TabControl1.TabIndex := TabControl1.TabIndex + 1;
  UpdateUI;
end;

end.
